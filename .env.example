# Open WebUI : adresse et jeton d'un compte administrateur (Réglages › Compte › Clés API, ou jeton de session).
OWUI_URL=http://127.0.0.1:8080
OWUI_JETON=
# Studio 3D : adresse interne (vue depuis le serveur d'Open WebUI) et jeton du studio.
STUDIO_URL=http://studio.studio3d.svc.cluster.local:8000
STUDIO_JETON=
# Identifiant d'un modèle de l'instance Open WebUI, qui traduit la réponse en script de scène.
MODELE_CODE=
# Nombre d'essais (code refusé, rendu en échec).
ESSAIS=3
